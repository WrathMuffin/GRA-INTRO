{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "52a8b106963742ec94d98e9f1f65b654",
    "m_Title": "Ripple/foam is based on noise",
    "m_Content": "This creates randomization to the water ripple as well. This can also creates more depth (illusion of more waves), which reduces amount of vertices transformed (less pointy and more huge wavey). So this basically makes the sea feels much powerful, large waves with smaller rippling waves within. Makign it moves also creates depth when it move faster as well as in reverse because the foam is much closer to the viewer than the depth of the sea.",
    "m_TextSize": 2,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1803.3333740234375,
        "y": 1594.0,
        "width": 925.0689086914063,
        "height": 510.4940185546875
    },
    "m_Group": {
        "m_Id": ""
    }
}

